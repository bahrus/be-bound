{
  "name": "be-bound",
  "version": "0.0.38",
  "keywords": [
    "web-components",
    "web-component",
    "custom-element",
    "custom-elements"
  ],
  "description": "be-bound is an attribute-based enhancement that provides limited 'two-way binding' support.",
  "main": "be-bound.js",
  "module": "be-bound.js",
  "exports": {
    ".": "./index.js",
    "./be-bound.js": "./be-bound.js",
    "./emc.js": "./emc.js"
  },
  "files": [
    "*.js",
    "types.d.ts"
  ],
  "types": "types.d.ts",
  "scripts": {
    "serve": "node ./node_modules/spa-ssi/serve.js",
    "test": "playwright test",
    "safari": "npx playwright wk http://localhost:8000",
    "update": "ncu -u && npm install"
  },
  "dependencies": {
    "be-enhanced": "0.0.187",
    "be-hive": "0.0.265",
    "mount-observer": "0.0.102",
    "trans-render": "0.0.958"
  },
  "devDependencies": {
    "spa-ssi": "0.0.10",
    "@playwright/test": "1.55.0",
    "xtal-element": "0.0.632"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bahrus/be-bound.git"
  },
